{
  "format": "nanogptpro.training_config.v4",
  "checkpointing": {
    "checkpoint_interval": 1000,
    "keep_last_checkpoints": 3
  },
  "data": {
    "block_size": 1024,
    "data_seed": 42,
    "document_schedule_chunk_size": 4096,
    "fit_or_cut_threshold": 100
  },
  "model": {
    "bitwise_deterministic": false,
    "torch_compile": true,
    "delta_rule_triton_dtype": "auto",
    "deterministic": false,
    "device": "cuda",
    "distribution": {
      "process_group_backend": "nccl",
      "strategy": "ddp"
    },
    "dtype": "bfloat16",
    "flash_attention_impl": "builtin",
    "embedding_init_std": 0.02,
    "embedding_lr_multiplier": 1,
    "extra_model_args": {
      "attention_norm_eps": 0.00001,
      "beta_scale_by_2": false,
      "delta_rule_block_size": 128,
      "delta_rule_chunk_bwd_impl": "triton",
      "delta_rule_chunk_size": 64,
      "fast_weight_beta": 0.5,
      "fast_weight_next_latent": true,
      "delta_expand_v": 1,
      "k_activation": "silu",
      "k_l2norm": true,
      "q_activation": "silu",
      "q_l2norm": true,
      "shortconv_kernel_size": 4,
      "shortconv_shift_right1_k": true,
      "shortconvk": true,
      "shortconvq": true,
      "shortconvv": true,
      "use_output_gate": true,
      "use_triton_delta_rule": true,
      "v_activation": "silu",
      "v_l2norm": false
