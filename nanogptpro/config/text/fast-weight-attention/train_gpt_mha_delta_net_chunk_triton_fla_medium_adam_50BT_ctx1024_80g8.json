    "head_dim": 128,
    "hidden_init_std_factor": 0.5,
    "hidden_size": 1024,
    "hidden_size_base": 1024,
    "model_type": "gpt-mha-delta_net_chunk_triton_fla",
    "num_attention_heads": 8,
    "num_hidden_layers": 24,
    "num_hidden_layers_base": 24,
    "num_key_value_heads": 1,
    "p_head_dim": null,
    "p_tie_mode": "none",
    "rope_ratio": 1,
    "training_seed": 42,
    "tpa_kvrank": 2,
    "tpa_qrank": 16,
    "use_k_shift": false,
    "use_qk_rmsnorm": false,
    "use_v_shift": false,
    "using_groupnorm": true
  },
  "name": "train_gpt_mha_delta_net_chunk_triton_fla_medium_adam_50BT_ctx1024_80g8",
  "optimization": {
    "amsgrad": false,
    "beta1": 0.9,
    "beta2": 0.95,
    "capturable": false,
    "decay_lr": true,
    "dropout": 0,
    "eps": 1E-8,
    "eval_interval": 1000,
    "eval_iters": 200,
    "foreach": null,
    "fused": null,
    "global_batch_size": 480,
    "grad_clip": 1,
    "ignore_doc_start_loss": false,
    "learning_rate_base": 0.001,
    "lr_decay_iters": 100000,
    "lr_schedule": "cosine",
    "max_iters": 100000,
    "micro_batch_size": 20,
    "min_lr_base": 0.00005,
    "min_weight_decay": null,
    "mucon_approx_rank": 16,
    "mucon_approx_regularization": 0.000001,
    "mucon_approx_steps": 4,
    "mucon_clip_method": "svd",
    "mucon_clip_threshold": 2,
    "mucon_rms_operator_scale": 8,
    "muon_rms_operator_scale": 0.2,
    "muon_momentum": 0.95,
    "muon_nesterov": true,
    "muon_ns_steps": 5,
    "muon_run_ns_in_bfloat16": true,
    "optimizer_name": "adamw",
    "parameterization": "widthmuP",
    "scheduler_unit": "iter",
